# Local secrets template. Copy to .env.local (git-ignored) and fill in, or let
# `scripts/dev.sh up` generate random values for every missing key.
# Never commit real values. All keys are for the local Compose environment only.

# ---- PostgreSQL (superuser + one login role per service schema) ----
POSTGRES_PASSWORD=
DB_PASSWORD_ACCOUNT=
DB_PASSWORD_MARKET=
DB_PASSWORD_ORDER=
DB_PASSWORD_LEDGER=
DB_PASSWORD_STRATEGY=
DB_PASSWORD_AUDIT=
DB_PASSWORD_KEYCLOAK=
DB_PASSWORD_APICURIO=

# ---- Redis ----
REDIS_PASSWORD=

# ---- Nacos (auth enabled) ----
# Base64 string decoding to >= 32 bytes, used to sign access tokens.
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
# Password of the built-in `nacos` admin user, set on first start.
NACOS_ADMIN_PASSWORD=
# Least-privilege accounts (scripts/dev.sh): `svc-dev` for all services (read config, register),
# `config-admin` for the account service's admin config API only (read and write config).
NACOS_SERVICE_PASSWORD=
NACOS_CONFIG_ADMIN_PASSWORD=

# ---- Vault (dev mode) ----
VAULT_DEV_ROOT_TOKEN=
