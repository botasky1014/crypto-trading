{
  "uid": "service-instances",
  "title": "Service Instances",
  "tags": [
    "crypto-trading",
    "jvm"
  ],
  "description": "Per service and instance: CPU, JVM memory, GC, threads, HTTP traffic (design.md 9.1, v0).",
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(jvm_memory_used_bytes, application)",
          "refId": "application-query"
        },
        "definition": "label_values(jvm_memory_used_bytes, application)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      },
